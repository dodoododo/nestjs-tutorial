# Used only by test:c2:setup and test:c2. Never use development credentials.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=nestjs_tutorial_c2_test
DB_USER=nestjs_c2_test
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Provisioning only; these are never copied into the application's environment.
# Use the test container's admin account, never the development server's account.
C2_DB_ADMIN_USER=root
C2_DB_ADMIN_PASSWORD=
